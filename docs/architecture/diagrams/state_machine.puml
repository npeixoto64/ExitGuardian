@startuml
title Gateway State Machine - Exit Guardian v3.0.0

' --- Global Layout Tweaks ---
skinparam state {
  StartColor #333333
  BorderColor #444444
  BackgroundColor #FFFFFF
}
hide empty description

[*] -down-> Boot

' ---------------- Boot ----------------
state Boot {
  Boot : entry / board_init
  Boot : entry / restore paired list & sensor states from NVM (FR_006, NFR_007, NFR_008)
  Boot : entry / IWDG enabled (NFR_004, 1 s)
}

Boot -down-> WaitingForConfig : [paired list empty] /* FR_006 */
Boot -right-> Monitoring       : [paired list non-empty] /* FR_006 */

' ---------------- Waiting-for-Configuration ----------------
state WaitingForConfig {
  WaitingForConfig : entry / Red LED ON (FR_007)
  WaitingForConfig : do    / Blue heartbeat 100 ms / 2 s (FR_004)
  WaitingForConfig : do    / Yellow LED OFF (FR_010)
  WaitingForConfig : do    / Refresh watchdog (NFR_004)
  WaitingForConfig : exit  / Red LED OFF
}

' ---------------- Monitoring ----------------
state Monitoring {
  [*] -down-> Idle

  state Idle {
    Idle : entry / Red LED OFF (FR_008)
    Idle : do    / evaluate ALERT on main-door event (FR_011) or sensor packet (FR_012)
  }

  state Alerting {
    Alerting : entry / Buzzer 2 s pulse (within 500 ms) & Red LED blink 200 ms / 50% (FR_013)
    Alerting : do    / Red LED blinking while ALERT active (FR_013)
    Alerting : exit  / truncate buzzer pulse & restore Red LED mode state (FR_013)
  }

  Idle -right-> Alerting : ALERT becomes true\n(main door OPEN ∧ ∃ paired window OPEN) /* FR_012 */
  Alerting -left-> Idle  : ALERT becomes false /* FR_012, FR_013 */

  Monitoring : do / Blue heartbeat (FR_004)
  Monitoring : do / Yellow low-batt flash 100 ms / 2 s in phase with blue (FR_024)
  Monitoring : do / Update last-known sensor state & battery in NVM (NFR_008)
}

' ---------------- Pairing/Unpairing Superstate ----------------
state PairingUnpairing {
  PairingUnpairing : entry / start 20 s timeout (FR_016)
  PairingUnpairing : do    / Blue heartbeat (FR_004)
  PairingUnpairing : do    / alerts SUSPENDED (FR_017)
  PairingUnpairing : do    / no ACK sent to sensor (FR_029)
  PairingUnpairing : exit  / stop yellow blink and pairing beep (FR_025)

  state PairingWindow {
    PairingWindow : do / Yellow LED 500 ms / 1 s (50% duty)\nBuzzer beep 500 ms / 1 s (FR_016)
  }

  state PairingMainDoor {
    PairingMainDoor : do / Yellow LED double flash 100 ms / 1 s\nBuzzer double beep 100 ms / 1 s (FR_016)
  }
}

' ---------------- Mode transitions into Pairing ----------------
WaitingForConfig -down-> PairingWindow   : button short press ≤ 2 s\n/* FR_014, FR_023 */
Monitoring       -down-> PairingWindow   : button short press ≤ 2 s\n/* FR_014, FR_023 */

WaitingForConfig -down-> PairingMainDoor : button double press\n/* FR_014, FR_023 */
Monitoring       -down-> PairingMainDoor : button double press\n/* FR_014, FR_023 */

' ---------------- Pairing Success / Exit Transitions ----------------
PairingWindow -up-> Monitoring : PAIR_REQ (new sensor ID)\n/ add window sensor, persist NVM, buzzer ON 2 s\n/* FR_019, NFR_007 */

PairingMainDoor -up-> Monitoring : PAIR_REQ (new sensor ID)\n/ replace main-door sensor, persist NVM, buzzer ON 2 s\n/* FR_015, FR_019, NFR_007 */

PairingUnpairing -left-> WaitingForConfig : UNPAIR_REQ (known ID) [no sensors remain]\n/ remove from NVM, buzzer ON 2 s /* FR_021 */

PairingUnpairing -up-> Monitoring : UNPAIR_REQ (known ID) [≥ 1 sensor remains]\n/ remove from NVM, buzzer ON 2 s /* FR_021 */

' Timeout, Ignored Requests, and Manual Cancel Exits
PairingUnpairing -left-> WaitingForConfig : Exit event [no sensors paired]\n(timeout 20 s / button press / ignored packet)\n/* FR_015, FR_016, FR_018, FR_020, FR_022 */

PairingUnpairing -up-> Monitoring : Exit event [≥ 1 sensor paired]\n(timeout 20 s / button press / ignored packet)\n/* FR_015, FR_016, FR_018, FR_020, FR_022 */

note right of PairingUnpairing
  <b>Exit Events:</b>
  • Timeout 20 s (FR_016, FR_018)
  • Button short press (FR_018)
  • PAIR_REQ existing ID (FR_015, FR_020)
  • UNPAIR_REQ unknown ID (FR_022)
  
  <i>Press (2 s, 5 s) ignored (FR_027). No ACK sent (FR_029).</i>
end note

' ---------------- Factory RESET ----------------
state FactoryReset <<choice>>

WaitingForConfig -down-> FactoryReset : button held ≥ 5 s & released /* FR_026 */
Monitoring       -down-> FactoryReset : button held ≥ 5 s & released /* FR_026 */
PairingUnpairing -down-> FactoryReset : button held ≥ 5 s & released /* FR_026 */

FactoryReset -up-> WaitingForConfig : clear paired list & NVM state\n/* FR_009, FR_028 */

note right of FactoryReset
  While holding ≥ 5 s: all LEDs blink 200 ms / 50% (FR_026).
  Press released in (2 s, 5 s) is ignored (FR_027).
  Watchdog hard RESET on SW fault (NFR_004, 1 s) re-enters Boot.
end note

@enduml